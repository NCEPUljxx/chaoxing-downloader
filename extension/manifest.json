{
  "manifest_version": 3,
  "name": "超星课件下载助手",
  "version": "7.0.0",
  "description": "一键下载超星课程资料，多选批量下载，绕过限制获取原始文件",
  "author": "CX Downloader",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "超星课件下载助手",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": ["downloads"],
  "host_permissions": [
    "*://*.chaoxing.com/*",
    "*://*.cldisk.com/*",
    "*://*.fanya.chaoxing.com/*"
  ],
  "content_scripts": [{
    "matches": [
      "*://*.chaoxing.com/*"
    ],
    "js": ["content.js"],
    "css": ["styles.css"],
    "run_at": "document_end",
    "all_frames": false
  }],
  "background": {
    "service_worker": "background.js"
  }
}
